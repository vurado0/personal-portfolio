# Copy to .env.local (never commit it) and fill in real values.
# On Vercel: Settings -> Environment Variables (Production + Preview).

# Client (public, VITE_ prefix)
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_APP_ID=1:...:web:...
VITE_USE_EMULATORS=false

# Server only (NO VITE_ prefix - never exposed to the browser)
FIREBASE_PROJECT_ID=<project-id>
ADMIN_UID=<your-firebase-uid>
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=...
CLOUDINARY_API_SECRET=...
# Content editor (/admin → Content): fine-grained token, Contents read/write on this repo only
GITHUB_TOKEN=github_pat_...
# GITHUB_REPO=vurado0/personal-portfolio
# GITHUB_BRANCH=main

# Optional: canonical site URL for sitemap/RSS/Open Graph (defaults to src/config/site.ts url,
# or the Vercel production URL during Vercel builds)
# SITE_URL=https://example.com
