{
  "name": "personal-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc -b",
    "build": "npm run validate:content && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "images:backgrounds": "bash scripts/convert-backgrounds.sh",
    "seed:feed": "tsx scripts/seed-feed.ts",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-portfolio"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^23.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "yaml": "^2.9.1"
  }
}
